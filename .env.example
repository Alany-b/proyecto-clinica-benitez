# Configuración opcional del stack.
# Copiar a .env en la raíz del proyecto para sobreescribir los valores por defecto
# de docker-compose.yml. NO es obligatorio: el proyecto funciona sin .env.

# --- Backend / Ollama ---
# Ollama corriendo en el host (Docker Desktop / WSL):
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Si usas un servicio "ollama" dentro del compose, cambia a:
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_CHAT_MODEL=agente-clinica
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_COLLECTION=protocolos_clinica

# --- Frontend (se embebe en build-time) ---
VITE_API_URL=http://localhost:8000
