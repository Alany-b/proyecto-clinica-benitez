# Copiar a .env para sobreescribir los valores por defecto de docker-compose.yml.

# Ollama corriendo en el host (Docker Desktop / WSL):
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Si usas un servicio "ollama" dentro del compose, cambia a:
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_CHAT_MODEL=agente-clinica
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_COLLECTION=protocolos_clinica
